{
  "name": "trello-player",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-popup.mjs",
    "build:popup": "node scripts/build-popup.mjs",
    "lint": "eslint .",
    "test": "node --test \"test/**/*.test.js\"",
    "check": "npm run lint && npm test && npm run build",
    "format": "prettier --write \"src/trello-power-up/popup/**/*.js\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  },
  "engines": {
    "node": ">=22"
  }
}
